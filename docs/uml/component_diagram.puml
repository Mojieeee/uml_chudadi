@startuml
skinparam componentStyle rectangle

package "App 模块" {
  [MainActivity]
  [Compose 发布版界面]
  [页面状态 Screen]
  [音乐与反馈]
  [游戏控制器]
  [AI 控制器]
  [玩家操作策略]
  [房间控制器]
  [玩家成长控制器]
  [玩家档案仓储]
  [规则与模型]
  [消息编解码]
  [主机权威同步]
  [连接健康与断线提示]
  [TransportEvent 事件流]
  [蓝牙传输]
  [本地模拟传输]
  [SharedPreferences]
  [Release 签名配置]
  [锄大地 APK]
}

cloud "Android 系统能力" {
  [Classic Bluetooth RFCOMM]
  [Bluetooth Permissions]
  [MediaPlayer / AudioTrack]
  [Vibrator]
}

[MainActivity] --> [Compose 发布版界面]
[Compose 发布版界面] --> [页面状态 Screen]
[Compose 发布版界面] --> [游戏控制器]
[Compose 发布版界面] --> [AI 控制器]
[Compose 发布版界面] --> [玩家操作策略]
[Compose 发布版界面] --> [房间控制器]
[Compose 发布版界面] --> [玩家成长控制器]
[Compose 发布版界面] --> [玩家档案仓储]
[Compose 发布版界面] --> [消息编解码]
[Compose 发布版界面] --> [连接健康与断线提示]
[Compose 发布版界面] --> [音乐与反馈]
[Compose 发布版界面] --> [SharedPreferences]

[游戏控制器] --> [规则与模型]
[AI 控制器] --> [游戏控制器]
[玩家操作策略] --> [游戏控制器]
[房间控制器] --> [消息编解码]
[房间控制器] --> [蓝牙传输]
[玩家成长控制器] --> [玩家档案仓储]
[玩家档案仓储] --> [SharedPreferences]
[消息编解码] --> [规则与模型]
[主机权威同步] --> [游戏控制器]
[主机权威同步] --> [消息编解码]
[连接健康与断线提示] --> [主机权威同步]
[连接健康与断线提示] --> [消息编解码]
[连接健康与断线提示] --> [蓝牙传输]
[蓝牙传输] --> [TransportEvent 事件流]
[TransportEvent 事件流] --> [连接健康与断线提示]
[蓝牙传输] --> [Classic Bluetooth RFCOMM]
[蓝牙传输] --> [Bluetooth Permissions]
[本地模拟传输] --> [消息编解码]
[音乐与反馈] --> [MediaPlayer / AudioTrack]
[音乐与反馈] --> [Vibrator]
[Release 签名配置] ..> [锄大地 APK] : assembleRelease
@enduml
