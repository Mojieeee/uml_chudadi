@startuml
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 45
left to right direction

node "手机 A\n房主端" as Host {
  artifact "锄大地 APK" as HostApk
  component "ChudadiApp\n权威牌局状态"
  component "HostTransport\n监听连接"
  component "AI 托管"
  database "本地存档\n规则/档案/设置"
}

cloud "Android 蓝牙栈\nClassic RFCOMM" as BT

node "手机 B/C/D\n加入端" as Client {
  artifact "锄大地 APK" as ClientApk
  component "ChudadiApp\n展示快照"
  component "ClientTransport\n发送请求"
  component "断线弹窗提示"
}

node "单机测试环境" as Test {
  component "LocalRoomTransport"
  component "SimulatedBluetoothHubTest"
  component "RoomSeatTest"
  component "GameMessageCodecTest"
}

node "开发与发布环境\nMac 电脑\nIDE 工具" as Dev {
  artifact "源码仓库"
  artifact "Release APK/AAB"
  artifact "Release keystore\n本机保存"
}

cloud "GitHub HTTPS 仓库" as GitHub

HostApk --> BT
ClientApk --> BT
BT -- Host
BT -- Client

Host --> Client : 房间/开局/快照
Client --> Host : 加入/准备/出牌/同步
Client --> Client : 房主断线后\n提示并退出
Test ..> Host
Test ..> Client
Dev --> Host
Dev --> Client
Dev --> GitHub : HTTPS push\n不上传私钥
@enduml
